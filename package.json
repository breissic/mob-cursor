{
  "name": "mob-cursor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:localdb": "vite --host --mode localdb",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b && tsc -p spacetimedb --noEmit && tsc -p worker",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb -y",
    "spacetime:build": "spacetime build --module-path spacetimedb",
    "spacetime:publish:local": "spacetime publish mob-cursor --module-path spacetimedb --server local -y",
    "spacetime:publish": "spacetime publish mob-cursor-9xp0y --module-path spacetimedb --server maincloud",
    "test": "tsx --test spacetimedb/test/*.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "spacetimedb": "2.10.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6"
  }
}
